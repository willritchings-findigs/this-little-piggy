{
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "meetings_held": {
   "type": "integer"
  },
  "trajectory_summary": {
   "type": "string",
   "description": "<=80 words: how the deal evolved across calls, evidence-based"
  },
  "momentum_inflection": {
   "type": "object",
   "properties": {
    "call_sequence": {
     "type": [
      "integer",
      "null"
     ],
     "description": "Sequence number of the call where momentum first clearly turned; null if never advanced or no inflection visible"
    },
    "type": {
     "type": "string",
     "enum": [
      "no_meeting_held_or_ghosted",
      "no_pain_or_poor_fit",
      "no_compelling_event_priority_shift",
      "price_or_budget",
      "price_shock_premature_pricing",
      "stakeholder_gap_no_decision_maker",
      "champion_lost_or_changed",
      "competitor_or_incumbent_chosen",
      "pms_bundled_screening",
      "pms_integration_gap",
      "feature_gap",
      "contract_terms_etf_commitment",
      "pilot_trial_unavailable_or_failed",
      "findigs_followup_or_execution_miss",
      "process_friction",
      "not_applicable_won",
      "insufficient_evidence"
     ]
    },
    "description": {
     "type": "string"
    },
    "evidence": {
     "type": "string",
     "description": "Verbatim supporting quote, <=25 words, already redacted (role tokens only). Empty string if status is not_discussed."
    }
   },
   "required": [
    "call_sequence",
    "type",
    "description",
    "evidence"
   ]
  },
  "primary_driver_transcript": {
   "type": "string",
   "enum": [
    "no_meeting_held_or_ghosted",
    "no_pain_or_poor_fit",
    "no_compelling_event_priority_shift",
    "price_or_budget",
    "price_shock_premature_pricing",
    "stakeholder_gap_no_decision_maker",
    "champion_lost_or_changed",
    "competitor_or_incumbent_chosen",
    "pms_bundled_screening",
    "pms_integration_gap",
    "feature_gap",
    "contract_terms_etf_commitment",
    "pilot_trial_unavailable_or_failed",
    "findigs_followup_or_execution_miss",
    "process_friction",
    "not_applicable_won",
    "insufficient_evidence"
   ]
  },
  "secondary_driver_transcript": {
   "type": "string",
   "enum": [
    "no_meeting_held_or_ghosted",
    "no_pain_or_poor_fit",
    "no_compelling_event_priority_shift",
    "price_or_budget",
    "price_shock_premature_pricing",
    "stakeholder_gap_no_decision_maker",
    "champion_lost_or_changed",
    "competitor_or_incumbent_chosen",
    "pms_bundled_screening",
    "pms_integration_gap",
    "feature_gap",
    "contract_terms_etf_commitment",
    "pilot_trial_unavailable_or_failed",
    "findigs_followup_or_execution_miss",
    "process_friction",
    "not_applicable_won",
    "insufficient_evidence",
    "none"
   ]
  },
  "stakeholder_pattern": {
   "type": "string",
   "enum": [
    "multithreaded_including_decision_maker",
    "single_threaded_decision_maker",
    "multithreaded_no_decision_maker",
    "single_threaded_non_decision_maker",
    "unknown"
   ]
  },
  "qualified_at_first_meeting": {
   "type": "string",
   "enum": [
    "yes",
    "marginal",
    "no",
    "unclear"
   ]
  },
  "qualification_rationale": {
   "type": "string"
  },
  "avoidability": {
   "type": "string",
   "enum": [
    "likely_avoidable",
    "possibly_avoidable",
    "structural_unavoidable",
    "not_applicable_won",
    "unclear"
   ]
  },
  "primary_lever": {
   "type": "string",
   "enum": [
    "qualification_booking",
    "discovery_quality",
    "pricing_presentation",
    "stakeholder_engagement",
    "product",
    "contract_terms_packaging",
    "follow_up_execution",
    "none",
    "unclear"
   ]
  },
  "unanswered_or_poorly_answered_prospect_questions": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "key_quotes": {
   "type": "array",
   "maxItems": 3,
   "items": {
    "type": "object",
    "properties": {
     "role_token": {
      "type": "string"
     },
     "quote": {
      "type": "string"
     },
     "why_it_matters": {
      "type": "string"
     }
    },
    "required": [
     "role_token",
     "quote",
     "why_it_matters"
    ]
   }
  },
  "confidence": {
   "type": "string",
   "enum": [
    "high",
    "medium",
    "low"
   ]
  }
 },
 "required": [
  "meetings_held",
  "trajectory_summary",
  "momentum_inflection",
  "primary_driver_transcript",
  "secondary_driver_transcript",
  "stakeholder_pattern",
  "qualified_at_first_meeting",
  "qualification_rationale",
  "avoidability",
  "primary_lever",
  "unanswered_or_poorly_answered_prospect_questions",
  "key_quotes",
  "confidence"
 ]
}