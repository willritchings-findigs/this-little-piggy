  "findigs_questions": {
   "type": "array",
   "description": "Substantive questions asked by Findigs reps (skip pleasantries/logistics unless qualification).",
   "items": {
    "type": "object",
    "properties": {
     "question_summary": {
      "type": "string",
      "description": "Paraphrase, <=20 words, no names"
     },
     "category": {
      "type": "string",
      "enum": [
       "situation",
       "problem",
       "implication",
       "need_payoff",
       "budget",
